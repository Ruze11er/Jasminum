// Cloudflare deploy settings (`npx wrangler deploy`). Jasminum has no server code: this
// only uploads the built app in dist/. App routes such as /notes get index.html through
// "single-page-application" (a catch-all line in _redirects is rejected by Cloudflare).
// Security headers still come from public/_headers.
{
  "name": "jasminum",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
